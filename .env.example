# .env.example
# 
# Este es un archivo de ejemplo para configurar las variables de entorno.
# Copia este archivo como .env y actualiza los valores según tu entorno.
#
# IMPORTANTE: El archivo .env está excluido del repositorio por razones de seguridad.
# Nunca comitees archivos .env con datos sensibles.

# URL del servicio en desarrollo (local)
# Cambia la IP y puerto según tu configuración local
DEV_API_URL=http://localhost:8000

# URL del servicio en producción (remoto)
# Actualizar cuando tengas la URL de producción real
PROD_API_URL=https://api.tuapp.com/api

# Configuraciones adicionales por entorno
DEV_TIMEOUT_SECONDS=30
PROD_TIMEOUT_SECONDS=15

# Configuración de logging
DEV_ENABLE_LOGGING=true
PROD_ENABLE_LOGGING=false

# Ejemplo de otras variables que podrías necesitar:
# API_KEY=tu_api_key_aqui
# DATABASE_URL=tu_database_url_aqui
# FIREBASE_PROJECT_ID=tu_firebase_project_id
# SENTRY_DSN=tu_sentry_dsn_aqui