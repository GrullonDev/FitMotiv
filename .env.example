# .env.example
#
# Copy this file as .env.dev or .env.prod and update the values.
# IMPORTANT: .env files are excluded from the repository for security.
# Never commit .env files with sensitive data.

# Environment identifier
ENVIRONMENT=development

# API URL for the Dart Frog backend
# For Android emulator: use http://10.0.2.2:8080
# For iOS simulator: use http://localhost:8080
# For physical device: use your machine's LAN IP
DEV_API_URL=http://localhost:8080
PROD_API_URL=https://api.fitmotiv.com

# Timeout configuration (seconds)
DEV_TIMEOUT_SECONDS=30
PROD_TIMEOUT_SECONDS=15

# Logging
DEV_ENABLE_LOGGING=true
PROD_ENABLE_LOGGING=false
