# ===============================================
# 🚫 FitMotiv - Archivos Excluidos del Repositorio
# ===============================================
# Este archivo define qué archivos y directorios
# NO deben subirse al repositorio por seguridad
# y buenas prácticas de desarrollo.

# ===============================================
# 📱 Flutter/Dart Core Files
# ===============================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
.packages
.metadata

# ===============================================
# 🔐 Variables de Entorno y Configuración Sensible
# ===============================================
# CRÍTICO: Estos archivos contienen URLs, claves API
# y configuraciones que NO deben ser públicas
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.staging
.env.test
# Permitir el template para que otros devs sepan qué variables configurar
!.env.example

# ===============================================
# 🔥 Firebase y Servicios Cloud
# ===============================================
# Archivos de configuración de Firebase que contienen
# claves y configuraciones específicas del proyecto
/ios/Runner/GoogleService-Info.plist
/android/app/google-services.json
/ios/firebase_app_id_file.json
firebase_options.dart
/lib/firebase_options.dart

# ===============================================
# 🔑 Claves y Certificados (iOS)
# ===============================================
# Certificados de distribución y perfiles de aprovisionamiento
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
*.p7b
AuthKey_*.p8
/ios/Runner/Runner.entitlements
/ios/Runner/Info.plist.backup

# ===============================================
# 🔑 Claves y Certificados (Android)
# ===============================================
# Archivos de firma para releases de Android
*.jks
*.keystore
key.properties
/android/key.properties
/android/app/upload-keystore.jks
/android/app/release-keystore.jks
signing.properties

# ===============================================
# 🏗️ Build Artifacts y Outputs
# ===============================================
# Archivos generados durante la compilación
/android/app/debug/
/android/app/profile/
/android/app/release/
/build/
**/build/
.dart_tool/build/
/ios/build/
/macos/build/
/windows/build/
/linux/build/
/web/build/

